DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brickwest_brewmaster
# On Railway, set DATABASE_URL instead of the DB_* values above.

# Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional but recommended on any public deployment: when set, new accounts
# can only be created by people who supply this code.
REGISTRATION_CODE=

PORT=3001
FRONTEND_URL=http://localhost:3000

# For production
NODE_ENV=development
